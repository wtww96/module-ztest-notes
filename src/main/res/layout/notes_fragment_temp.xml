<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.dp.common.widget.tablayout.SlidingTabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:tl_indicator_color="#ff0000"
        app:tl_indicator_corner_radius="2dp"
        app:tl_indicator_height="3dp"
        app:tl_indicator_margin_bottom="5.5dp"
        app:tl_indicator_width="18dp"
        app:tl_tab_padding="12dp"
        app:tl_textSelectBold="true"
        app:tl_textSelectColor="#00ff00"
        app:tl_textSelectsize="19sp"
        app:tl_textUnselectColor="#808080"
        app:tl_textsize="16sp" />


    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>