<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_corners_10"
    android:backgroundTint="#0000ff">

    <TextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#40ff0000"
        android:text="复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发复活甲按实际发生的骄傲时代束带结发"
        app:layout_constraintBottom_toTopOf="@+id/etContent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#0000ff"
        android:text="6666666666666"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text" />

    <EditText
        android:id="@+id/etContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="155dp"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="输入框是否显示"
        app:layout_constraintTop_toBottomOf="@+id/etContent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="继续弹窗"
        android:textColor="@color/black"
        app:backgroundTint="#00ff00"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@+id/button1" />


    <TextView
        android:id="@+id/tvBtn"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        android:background="#000000"
        android:elevation="5dp"
        android:gravity="center"
        android:text="我是按钮"
        android:textColor="#ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>